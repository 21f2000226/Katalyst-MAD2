SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
SQLALCHEMY_DATABASE_URI=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123
ADMIN_EMAIL=admin@placement.local
CORS_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=3000  
FLASK_DEBUG=1 # True

# Redis running on docker container
# DB 0 = cache, DB 1 = Celery broker, DB 2 = Celery results
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONTAINER_NAME=Katalyst-redis
CACHE_TYPE=RedisCache
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=katalyst_
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# MailHog is running on docker with command 'docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog'
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USE_TLS=0
SMTP_USER= # optional
SMTP_PASSWORD=
SMTP_FROM=katalyst@localhost
ADMIN_EMAIL=admin@placement.local
